v><span class=\"report-label\">Ruta:</span> {{ruta}}</div>\n      {{#if assigned_employee.name}}\n      <div><span class=\"report-label\">Empleado asignado:</span> {{assigned_employee.name}}</div>\n      {{/if}}\n      {{#if init_time}}\n      <div><span class=\"report-label\">Inicio:</span> {{init_time}}</div>\n      {{/if}}\n      {{#if end_time}}\n      <div><span class=\"report-label\">Fin:</span> {{end_time}}</div>\n      {{/if}}\n      {{#if invoice_request_name}}\n      <div><span class=\"report-label\">Solicitud factura:</span> {{invoice_request_name}} ({{invoice_request_estado}})</div>\n      {{/if}}\n    </div>\n  </div>\n\n  {{#if observaciones}}\n  <div class=\"mb-2 report-pedido-observaciones\">\n    <div class=\"report-section-title\">Observaciones del pedido</div>\n    <div>{{observaciones}}</div>\n  </div>\n  {{/if}}\n\n  <hr class=\"report-line\">\n\n  <table class=\"table table-sm table-bordered mb-2\">\n    <thead>\n      <tr>\n        <th style=\"width: 3%;\" class=\"text-center report-partida\">No.</th>\n        <th style=\"width: 13%;\">Código</th>\n        <th style=\"width: 11%;\" class=\"text-center\">Cant. surtida</th>\n        <th style=\"width: 11%;\" class=\"text-center report-cantidad\">Cant. por surtir</th>\n        <th style=\"width: 39%;\">Producto</th>\n        <th style=\"width: 23%;\">Observaciones de la partida</th>\n      </tr>\n    </thead>\n    <tbody>\n      {{#each articulos}}\n      <tr>\n        <td class=\"text-center report-partida\">{{@number}}</td>\n        <td><strong>{{product.codigo}}</strong></td>\n        <td class=\"text-center report-surtida-cell\">&nbsp;</td>\n        <td class=\"text-center report-cantidad\">{{cantidad}}</td>\n        <td>{{product.name}}</td>\n        <td class=\"report-partida-observaciones\">{{this.observaciones}}</td>\n      </tr>\n      {{/each}}\n    </tbody>\n  </table>\n\n  <div class=\"report-muted\" style=\"font-size: 7.5pt; margin-bottom: 0.35rem;\">\n    Complete a mano la columna 