      "_ref": "reports-pedido-tablero-0",
      "name": "Pedido | Formato de impresión",
      "description": "Formato de impresión del pedido (Designer / PDF, estilo Imperium). Imprime desde el módulo de reportes o el tablero de pedidos.",
      "related_model": "Pedidos",
      "page_size": "Letter",
      "html_content": "<style>\n  .report-root {\n    font-size: 9pt;\n    line-height: 1.3;\n    color: #23344d;\n  }\n  .report-root table {\n    width: 100%;\n    table-layout: fixed;\n    border-collapse: collapse;\n  }\n  .report-root th,\n  .report-root td {\n    word-break: break-word;\n    overflow-wrap: anywhere;\n    vertical-align: top;\n    padding: 0.22rem 0.3rem;\n    border: 1px solid #bac9e2;\n    font-size: 8.5pt;\n  }\n  .report-root thead th {\n    background: #f4f7fc;\n    font-weight: 700;\n    font-size: 8pt;\n  }\n  .report-root img {\n    max-width: 100%;\n    height: auto;\n  }\n  .report-muted {\n    color: #63748f;\n  }\n  .report-header-band {\n    background: transparent;\n    color: #23344d;\n    padding: 0.25rem 0 0.45rem 0;\n    border-bottom: 2px solid #23344d;\n  }\n  .report-line {\n    border: 0;\n    border-top: 1px solid #bac9e2;\n    margin: 0.55rem 0;\n  }\n  .report-section-title {\n    font-size: 8.5pt;\n    font-weight: 700;\n    color: #23344d;\n    margin: 0 0 0.2rem 0;\n    letter-spacing: 0.02em;\n  }\n  .report-label {\n    color: #63748f;\n    font-size: 8pt;\n  }\n  .report-surtida-cell {\n    min-height: 1.35rem;\n  }\n  /* #293: el renglón es solo referencia (angosto y tenue, texto atenuado de\n     marca); la cantidad es lo que se lee (negrita, fondo primario de marca al\n     14 %). exact: que Chrome no quite el fondo al imprimir. */\n  .report-root .report-partida {\n    padding-left: 0.05rem;\n    padding-right: 0.05rem;\n    font-size: 6.5pt;\n    font-weight: 400;\n    color: rgba(99, 116, 143, 0.75);\n  }\n  .report-root .report-cantidad {\n    font-weight: 700;\n    background: rgba(125, 156, 248, 0.14);\n    -webkit-print-color-adjust: exact;\n    print-color-adjust: exact;\n  }\n</style>\n\n<div class=\"report-root\">\n  <div class=\"report-header-band mb-2\">\n    <div class=\"row\">\n      <div class=\"col-7\">\n        <div style=\"font-size: 7.5pt; letter-spacing: 0.05em; color: #63748f;\">PEDIDO</div>\n        <div class=\"report-pedido-name\" style=\"font-size: 13pt; font-weight: 700; line-height: 1.15; margin: 0.05rem 0;\">{{name}}</div>\n        <div style=\"font-size: 8pt;\">Folio: {{folio}} · Folio interno: {{folio_interno}}</div>\n      </div>\n      <div class=\"col-5 text-end\">\n        <div style=\"font-size: 8pt;\">Estado: <strong>{{estado}}</strong></div>\n        <div style=\"font-size: 8pt;\">{{fecha_actual}}</div>\n        <div style=\"font-size: 7.5pt; color: #63748f;\">{{hora_actual}}</div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"row mb-2\">\n    <div class=\"col-6\" style=\"padding-right: 0.75rem;\">\n      <div class=\"report-section-title\">Cliente</div>\n      {{#if contacto.name}}\n      <div style=\"font-weight: 700; font-size: 9pt;\">{{#if contacto.codigo}}[{{contacto.codigo}}] {{/if}}{{contacto.name}}</div>\n      {{else}}\n      <div class=\"report-muted\" style=\"font-weight: 700; font-size: 9pt;\">Sin cliente</div>\n      {{/if}}\n      {{#if contacto.rfc}}\n      <div><span class=\"report-label\">RFC:</span> {{contacto.rfc}}</div>\n      {{/if}}\n      {{#if contacto.nombre_fiscal}}\n      <div><span class=\"report-label\">Nombre fiscal:</span> {{contacto.nombre_fiscal}}</div>\n      {{/if}}\n      <div style=\"margin-top: 0.15rem;\">\n        {{contacto.calle}}{{#if contacto.numeroExterior}} {{contacto.numeroExterior}}{{/if}}{{#if contacto.numeroInterior}} Int. {{contacto.numeroInterior}}{{/if}}\n      </div>\n      <div>\n        {{contacto.colonia}}{{#if contacto.codigoPostal}} · C.P. {{contacto.codigoPostal}}{{/if}}\n      </div>\n      <div>\n        {{contacto.ciudad}}{{#if contacto.estado}}, {{contacto.estado}}{{/if}}{{#if contacto.pais}}, {{contacto.pais}}{{/if}}\n      </div>\n    </div>\n    <div class=\"col-6\" style=\"padding-left: 0.75rem;\">\n      <div class=\"report-section-title\">Datos del pedido</div>\n      <div><span class=\"report-label\">Vendedor:</span> {{usuario.name}}</div>\n      <div><span class=\"report-label\">Ruta:</span> {{ruta}}</div>\n      <div><span class=\"report-label\">Lista de precios:</span> {{listaDePreciosId.name}}</div>\n      {{#if assigned_employee.name}}\n      <div><span class=\"report-label\">Empleado asignado:</span> {{assigned_employee.name}}</div>\n      {{/if}}\n      {{#if init_time}}\n      <div><span class=\"report-label\">Inicio:</span> {{init_time}}</div>\n      {{/if}}\n      {{#if end_time}}\n      <div><span class=\"report-label\">Fin:</span> {{end_time}}</div>\n      {{/if}}\n      {{#if invoice_request_name}}\n      <div><span class=\"report-label\">Solicitud factura:</span> {{invoice_request_name}} ({{invoice_request_estado}})</div>\n      {{/if}}\n    </div>\n  </div>\n\n  {{#if observaciones}}\n  <div class=\"mb-2 report-pedido-observaciones\">\n    <div class=\"report-section-title\">Observaciones del pedido</div>\n    <div>{{observaciones}}</div>\n  </div>\n  {{/if}}\n\n  <hr class=\"report-line\">\n\n  <table class=\"table table-sm table-bordered mb-2\">\n    <thead>\n      <tr>\n        <th style=\"width: 3%;\" class=\"text-center report-partida\">No.</th>\n        <th style=\"width: 8%;\" class=\"text-center report-cantidad\">Cant.</th>\n        <th style=\"width: 8%;\" class=\"text-center\">Surt.</th>\n        <th style=\"width: 36%;\">Producto</th>\n        <th style=\"width: 11%;\" class=\"text-end\">Precio</th>\n        <th style=\"width: 11%;\" class=\"text-end\">Importe</th>\n        <th style=\"width: 23%;\">Observaciones de la partida</th>\n      </tr>\n    </thead>\n    <tbody>\n      {{#each articulos}}\n      <tr>\n        <td class=\"text-center report-partida\">{{@number}}</td>\n        <td class=\"text-center report-cantidad\">{{cantidad}}</td>\n        <td class=\"text-center\">{{cantidad_surtida}}</td>\n        <td><strong>{{product.codigo}}</strong> {{product.name}}</td>\n        <td class=\"text-end\">{{precio}}</td>\n        <td class=\"text-end\">{{importe}}</td>\n        <td class=\"report-partida-observaciones\">{{this.observaciones}}</td>\n      </tr>\n      {{/each}}\n    </tbody>\n  </table>\n\n  <div class=\"row\">\n    <div class=\"col-6\">\n      {{#if price_origin}}\n      <div class=\"report-muted\" style=\"font-size: 7.5pt;\">Origen de precios: {{price_origin}}</div>\n      {{/if}}\n    </div>\n    <div class=\"col-6\">\n      <table class=\"table table-sm mb-0\" style=\"border: none; width: 100%;\">\n        <tr>\n          <td class=\"text-end\" style=\"border: none; width: 55%; padding: 0.15rem 0.3rem; font-weight: 700;\">Importe</td>\n          <td class=\"text-end\" style=\"border: none; width: 45%; padding: 0.15rem 0.3rem;\">{{importe}}</td>\n        </tr>\n        <tr>\n          <td class=\"text-end\" style=\"border: none; padding: 0.15rem 0.3rem; font-weight: 700;\">IVA</td>\n          <td class=\"text-end\" style=\"border: none; padding: 0.15rem 0.3rem;\">{{iva}}</td>\n        </tr>\n        <tr>\n          <td class=\"text-end\" style=\"border: none; padding: 0.2rem 0.3rem; font-weight: 700; font-size: 9.5pt;\">Total</td>\n          <td class=\"text-end\" style=\"border: none; padding: 0.2rem 0.3rem; font-weight: 700; font-size: 9.5pt;\">{{total}}</td>\n        </tr>\n      </table>\n    </div>\n  </div>\n\n  <hr class=\"report-line\">\n\n  <div class=\"d-flex justify-content-between report-muted\" style=\"font-size: 7.5pt;\">\n    <div>Generado por {{usuario_genera}} · {{timestamp_actual}}</div>\n    <div>{{#if sincronizado}}Sincronizado{{/if}}{{#if offline_uuid}} · Offline {{offline_uuid}}{{/if}}</div>\n  </div>\n</div>",
      "generated_report_name": "PEDIDO_{{folio_interno}}_{{timestamp_actual}}",
      "is_active": true
    },
