      "name": "Dispositivos | Inventario",
      "description": "Inventario de dispositivos (varios registros): nombre, tipo, modelo, serie, sistema, CPU, RAM, discos, GPU, último usuario y última revisión. Imprime la selección o el filtro de la lista (#337).",
      "related_model": "physical-device",
      "page_size": "Letter",
      "html_content": "<style>\n  .report-root { font-size: 8.5pt; line-height: 1.3; color: #23344d; }\n  .report-root table { width: 100%; border-collapse: collapse; table-layout: fixed; }\n  .report-root th, .report-root td { border-bottom: 1px solid #d5dce6; padding: 0.2rem 0.25rem; text-align: left; vertical-align: top; word-break: break-word; overflow-wrap: anywhere; }\n  .report-root th { background: #eef2f7; font-weight: 700; }\n  .report-title { font-size: 13pt; font-weight: 700; margin: 0.1rem 0; }\n  .report-muted { color: #63748f; font-size: 7.5pt; }\n  .report-section-title { font-weight: 700; margin: 0.5rem 0 0.2rem; }\n  @page { size: Letter; margin: 12mm; }\n</style>\n<div class=\"report-root\">\n  <div class=\"report-muted\">INVENTARIO DE DISPOSITIVOS</div>\n  <div class=\"report-title\">Inventario de dispositivos</div>\n  <div class=\"report-muted\">{{fecha_actual}} {{hora_actual}} · Generó: {{usuario_genera}} · Total: {{total_registros}}</div>\n  <table style=\"margin-top: 0.5rem;\">\n    <thead>\n      <tr>\n        <th style=\"width: 4%;\">#</th>\n        <th style=\"width: 14%;\">Nombre</th>\n        <th style=\"width: 8%;\">Tipo</th>\n        <th style=\"width: 14%;\">Fabricante / modelo</th>\n        <th style=\"width: 9%;\">Serie</th>\n        <th style=\"width: 12%;\">Sistema</th>\n        <th style=\"width: 12%;\">Procesador</th>\n        <th style=\"width: 6%;\">RAM</th>\n        <th style=\"width: 8%;\">Discos</th>\n        <th style=\"width: 10%;\">GPU</th>\n        <th style=\"width: 9%;\">Último usuario</th>\n        <th style=\"width: 9%;\">Última revisión</th>\n      </tr>\n    </thead>\n    <tbody>\n      {{#each registros}}\n      <tr>\n        <td>{{@number}}</td>\n        <td>{{name}}{{#if is_active == false}} <span class=\"report-muted\">(inactivo)</span>{{/if}}</td>\n        <td>{{device_kind}}</td>\n        <td>{{manufacturer}} {{model}}</td>\n        <td>{{serial}}</td>\n        <td>{{os_distro}} {{os_release}}</td>\n        <td>{{cpu_brand}}</td>\n        <td>{{ram_gb}}</td>\n        <td>{{disk_count}} · {{disk_total_gb}}</td>\n        <td>{{gpu_primary}}{{#if vram_gb}} · {{vram_gb}}{{/if}}</td>\n        <td>{{last_user_name}}</td>\n        <td>{{ultima_revision}}</td>\n      </tr>\n      {{/each}}\n    </tbody>\n  </table>\n  <div class=\"report-section-title\">Total de dispositivos: {{total_registros}}</div>\n</div>\n",
      "generated_report_name": "INVENTARIO_DISPOSITIVOS_{{timestamp_actual}}",
      "is_active": true
    },
    "refs": {}
